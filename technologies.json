    "version_pattern": "ver=([0-9.]+)|WordPress ([0-9.]+)|Version ([0-9.]+)",
    "cookies": ["wordpress_logged_in", "wp-settings"],
    "headers": {"X-Pingback": ".*"},
    "meta": {"generator": "wordpress"}
  },
